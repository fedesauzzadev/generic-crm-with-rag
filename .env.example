# Opcional — todo tiene defaults de demo y el proyecto funciona sin este archivo.
# Puerto del server API (default 8787).
PORT=8787
# Secreto de firma de la sesión demo (se usa desde el slice S02; default embebido de demo).
SESSION_SECRET=change-me-if-you-want

# Asistente de chat (RAG V1) — opcional. Sin CRM_LLM_API_KEY el asistente
# responde con una degradación honesta y el CRM sigue 100% operativo.
# Requiere un endpoint OpenAI-compatible con tool-calling (ver README §Assistant).
CRM_LLM_API_KEY=
# Endpoint /chat/completions OpenAI-compatible.
# Opción gratis probada: OpenRouter (https://openrouter.ai/keys, sin tarjeta).
CRM_LLM_BASE_URL=https://openrouter.ai/api/v1
# Modelo en ese endpoint. Con OpenRouter, probados y OK:
#   nvidia/nemotron-3-ultra-550b-a55b:free  (mejor fidelidad numérica — recomendado)
#   openrouter/free                         (router de modelos gratis, calidad variable)
CRM_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
